<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — أرشيف الشكابة شاع الدين</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var dbUser = User.Identity?.IsAuthenticated == true ? User.CurrentAppUser() : null;
    var isAdmin = User.IsInRole("Admin") || dbUser?.IsAdmin == true || dbUser?.Role == UserRole.Admin;
    var isApprover = isAdmin || User.IsInRole("Approver") || dbUser?.CanApprove == true;
    var isEditorOnly = User.Identity?.IsAuthenticated == true && !isApprover;
}
<header class="site-header">
    <div class="container py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <a class="brand" asp-page="/Index">أرشيف الشكابة شاع الدين</a>
        <nav class="d-flex flex-wrap gap-3 align-items-center">
            <a asp-page="/Index">الرئيسية</a>
            <a asp-page="/People/Index">سجل الأشخاص</a>
            <a asp-page="/Occasions/Index">المناسبات</a>
            @if (isApprover)
            {
                <a asp-page="/Reports/MigrantsReport">تقرير المغتربين</a>
            }
            <a class="btn-whatsapp-nav" href="@WhatsAppShare.SiteShareUrl()" target="_blank" rel="noopener">واتساب</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/People/Create">إضافة بياناتي</a>
                <a asp-page="/Occasions/Create">إضافة مناسبة</a>
                @if (isApprover)
                {
                    <a asp-page="/Approvals/Index">الموافقة على البيانات</a>
                }
                else
                {
                    <a asp-page="/Approvals/Index">طلباتي بانتظار الموافقة</a>
                }
                @if (isAdmin)
                {
                    <a asp-page="/Account/Users">المستخدمون</a>
                    <a asp-page="/Account/UsersReport">تقرير المستخدمين</a>
                    <a asp-page="/Account/Invites">أرقام الدعوة</a>
                }
                <span class="muted">@User.Identity.Name</span>
                <a asp-page="/Account/ChangePassword">تغيير كلمة المرور</a>
                <a asp-page="/Account/Logout">خروج</a>
            }
            else
            {
                <a asp-page="/Account/Register">تسجيل حساب جديد</a>
                <a class="btn-login" asp-page="/Account/Login">دخول</a>
            }
        </nav>
    </div>
</header>

<main class="container py-4">
    @if (isEditorOnly)
    {
        <div class="alert alert-info py-2 small">
            حسابك لإدخال بياناتك والمناسبات. يمكنك تعديل سجلك فقط بعد اعتماده — وليس بيانات الآخرين.
        </div>
    }
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container py-3">
        أرشيف الشكابة شاع الدين — إهداء إلى روح المرحوم — عبدالمحمود محمد علي — تصميم عمر عبدالمحمود
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
