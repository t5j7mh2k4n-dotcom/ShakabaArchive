@page
@model ShakabaArchive.Web.Pages.People.IndexModel
@{
    ViewData["Title"] = "السجلات";
    var canManage = User.Identity?.IsAuthenticated == true;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">سجلات الأرشيف</h1>
    @if (canManage)
    {
        <a class="btn btn-accent" asp-page="Create">إضافة شخص</a>
    }
</div>

<form method="get" class="card-panel mb-3">
    <div class="row g-2 search-bar">
        <div class="col-md-6">
            <input class="form-control" name="q" value="@Model.Q" placeholder="بحث..." />
        </div>
        <div class="col-md-4">
            <select class="form-select" name="birthPlace" asp-items="Model.BirthPlaceOptions">
                <option value="">كل أماكن الميلاد</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-soft w-100" type="submit">تصفية</button>
        </div>
    </div>
</form>

<div class="card-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>الاسم</th>
                <th>الرقم الوطني</th>
                <th>مكان الميلاد</th>
                <th>الحي</th>
                <th>المناسبات</th>
                @if (canManage)
                {
                    <th style="width:140px">إجراءات</th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.People)
            {
                <tr>
                    <td><a asp-page="Details" asp-route-id="@p.Id">@p.FullName</a></td>
                    <td>@p.NationalId</td>
                    <td>@p.BirthPlace</td>
                    <td>@p.Neighborhood</td>
                    <td><span class="badge badge-soft">@p.Events.Count</span></td>
                    @if (canManage)
                    {
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a class="btn btn-sm btn-soft" asp-page="/Occasions/Create" asp-route-personId="@p.Id">مناسبة</a>
                                <a class="btn btn-sm btn-soft" asp-page="Edit" asp-route-id="@p.Id">تعديل</a>
                                <form method="post" asp-page-handler="Delete" class="d-inline"
                                      onsubmit="return confirm('حذف هذا السجل وجميع مناسباته؟');">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger-soft">حذف</button>
                                </form>
                            </div>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.People.Count == 0)
    {
        <p class="muted mt-3 mb-0">لا توجد نتائج.</p>
    }
</div>
