@page
@model ShakabaArchive.Web.Pages.People.IndexModel
@{
    ViewData["Title"] = "سجل الأشخاص";
    var canManage = User.Identity?.IsAuthenticated == true;
    string Dash(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">سجل الأشخاص</h1>
        <p class="muted mb-0">يعرض كل بيانات الإضافة — ترميز: 01 ← 01001 ← 01001001</p>
    </div>
    @if (canManage)
    {
        <a class="btn btn-accent" asp-page="Create">إضافة سجل</a>
    }
</div>

@if (TempData["Flash"] is string flash && !string.IsNullOrEmpty(flash))
{
    <div class="alert alert-success">@flash</div>
}

@if (Model.PendingPeople.Count > 0)
{
    <div class="card-panel mb-3 border-warning">
        <h2 class="h6 mb-2">طلبات إضافة بانتظار الاعتماد (@Model.PendingPeople.Count)</h2>
        <p class="muted small mb-3">هذه السجلات حُفظت مؤقتاً ولن تظهر في الجدول النهائي إلا بعد موافقة أحد الثلاثة.</p>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                <tr>
                    <th>الكود</th>
                    <th>الاسم</th>
                    <th>الوثيقة</th>
                    <th>مقدّم الطلب</th>
                    <th>التاريخ</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.PendingPeople)
                {
                    <tr>
                        <td><code>@row.RegistryCode</code></td>
                        <td>@row.FullName</td>
                        <td>@row.DocumentType — @row.DocumentNumber</td>
                        <td>@row.SubmittedByName</td>
                        <td>@row.SubmittedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a class="btn btn-sm btn-soft" asp-page="EditPending" asp-route-id="@row.PendingId">تعديل</a>
                            <a class="btn btn-sm btn-accent" asp-page="/Approvals/Index">اعتماد</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<form method="get" action="/People" class="card-panel mb-3">
    <div class="row g-2 search-bar">
        <div class="col-md-5">
            <input class="form-control" name="q" value="@Model.Q" placeholder="بحث بالكود أو الاسم أو رقم الوثيقة..." />
        </div>
        <div class="col-md-3">
            <select class="form-select" name="level">
                <option value="">كل المستويات</option>
                @if (Model.Level == 1) { <option value="1" selected>المستوى الأول</option> } else { <option value="1">المستوى الأول</option> }
                @if (Model.Level == 2) { <option value="2" selected>المستوى الثاني</option> } else { <option value="2">المستوى الثاني</option> }
                @if (Model.Level == 3) { <option value="3" selected>المستوى الثالث</option> } else { <option value="3">المستوى الثالث</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-select" name="birthPlace" asp-items="Model.BirthPlaceOptions">
                <option value="">كل أماكن الميلاد</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-accent w-100" type="submit">بحث</button>
        </div>
    </div>
</form>

<div class="card-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 table-people-full">
            <thead>
            <tr>
                <th></th>
                <th>الكود</th>
                <th>الباركود</th>
                <th>المستوى</th>
                <th>الاسم الأول</th>
                <th>اسم الأب</th>
                <th>اسم الجد</th>
                <th>اسم العائلة</th>
                <th>اسم الأم</th>
                <th>النوع</th>
                <th>تاريخ الميلاد</th>
                <th>مكان الميلاد</th>
                <th>المهنة</th>
                <th>الإقامة</th>
                <th>الحي</th>
                <th>الهاتف</th>
                <th>نوع الوثيقة</th>
                <th>رقم الوثيقة</th>
                <th>ملاحظات</th>
                @if (canManage)
                {
                    <th>إجراءات</th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.People)
            {
                <tr>
                    <td style="width:52px">
                        @if (!string.IsNullOrWhiteSpace(p.PhotoPath))
                        {
                            <a asp-page="Details" asp-route-id="@p.Id">
                                <img class="person-photo-list" src="~/uploads/@p.PhotoPath" alt="" />
                            </a>
                        }
                    </td>
                    <td><code>@p.RegistryCode</code></td>
                    <td class="person-barcode-cell">
                        <partial name="_PersonBarcode" model="PersonBarcodeView.ForPerson(p, compact: true)" />
                    </td>
                    <td>@PersonRegistryService.LevelLabel(p.HierarchyLevel)</td>
                    <td><a asp-page="Details" asp-route-id="@p.Id">@Dash(p.FirstName)</a></td>
                    <td>@Dash(p.FatherName)</td>
                    <td>@Dash(p.GrandfatherName)</td>
                    <td>@Dash(p.FamilyName)</td>
                    <td>@Dash(p.MotherName)</td>
                    <td>@Dash(p.Gender)</td>
                    <td>@(p.BirthDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                    <td>@Dash(p.BirthPlace)</td>
                    <td>@Dash(p.Profession)</td>
                    <td>@Dash(p.Residence)</td>
                    <td>@Dash(p.Neighborhood)</td>
                    <td>@Dash(p.Phone)</td>
                    <td>@Dash(string.IsNullOrWhiteSpace(p.DocumentType) ? DocumentTypes.NationalId : p.DocumentType)</td>
                    <td>@Dash(string.IsNullOrWhiteSpace(p.DocumentNumber) ? p.NationalId : p.DocumentNumber)</td>
                    <td class="notes-cell">@Dash(p.Notes)</td>
                    @if (canManage)
                    {
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-soft" asp-page="/Occasions/Create" asp-route-personId="@p.Id">مناسبة</a>
                            <a class="btn btn-sm btn-soft" asp-page="Edit" asp-route-id="@p.Id">تعديل</a>
                            <form method="post" asp-page-handler="Delete" class="d-inline"
                                  onsubmit="return confirm('إرسال طلب حذف هذا السجل؟');">
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" class="btn btn-sm btn-danger-soft">طلب حذف</button>
                            </form>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.People.Count == 0)
    {
        <p class="muted mt-3 mb-0">لا توجد نتائج في سجل الأشخاص.</p>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <script src="~/js/person-barcode.js" asp-append-version="true"></script>
}
