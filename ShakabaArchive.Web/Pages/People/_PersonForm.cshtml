@model ShakabaArchive.Web.Pages.People.PersonInput
@{
    var showParent = Model.HierarchyLevel is 2 or 3;
    var isEdit = ViewData["IsEdit"] as bool? == true;
    var allowPartial = ViewData["AllowPartial"] as bool? == true;
    var registryCode = ViewData["RegistryCode"] as string;
    var lockHierarchy = ViewData["LockHierarchy"] as bool? == true || isEdit;
}

<div class="alert alert-info small">
    موديول <strong>سجل الأشخاص</strong> —
    المستوى الأول: <code>01</code>،
    الثاني: <code>01001</code>،
    الثالث: <code>01001001</code>.
    يُولَّد الكود تلقائياً عند الحفظ.
</div>

@if (!string.IsNullOrWhiteSpace(registryCode))
{
    <div class="mb-3">
        <label class="form-label">كود السجل</label>
        <input class="form-control" value="@registryCode" readonly />
    </div>
}

<div class="row g-3">
    @if (!lockHierarchy)
    {
        <div class="col-md-4">
            <label class="form-label">المستوى</label>
            <select class="form-select" asp-for="HierarchyLevel" id="hierarchyLevel"
                    onchange="location.href='?level=' + this.value">
                <option value="1">المستوى الأول (01)</option>
                <option value="2">المستوى الثاني (01001)</option>
                <option value="3">المستوى الثالث (01001001)</option>
            </select>
        </div>
        <div class="col-md-8" id="parentWrap" style="@(showParent ? "" : "display:none")">
            <label class="form-label">السجل الأب</label>
            <select class="form-select" asp-for="ParentPersonId" asp-items="ViewBag.ParentOptions">
                <option value="">— اختر الأب —</option>
            </select>
            <div class="form-text">للمستوى 2 اختر أباً من المستوى 1، وللثالث أباً من المستوى 2.</div>
        </div>
    }
    else
    {
        <input type="hidden" asp-for="HierarchyLevel" />
        <input type="hidden" asp-for="ParentPersonId" />
        <div class="col-md-4">
            <label class="form-label">المستوى</label>
            <input class="form-control" value="@PersonRegistryService.LevelLabel(Model.HierarchyLevel)" readonly />
        </div>
    }

    <div class="col-md-3">
        <label class="form-label">الاسم الأول</label>
        <input class="form-control" asp-for="FirstName" required />
    </div>
    <div class="col-md-3">
        <label class="form-label">اسم الأب</label>
        @if (allowPartial)
        {
            <input class="form-control" asp-for="FatherName" />
        }
        else
        {
            <input class="form-control" asp-for="FatherName" required />
        }
    </div>
    <div class="col-md-3">
        <label class="form-label">اسم الجد</label>
        <input class="form-control" asp-for="GrandfatherName" />
    </div>
    <div class="col-md-3">
        <label class="form-label">اسم العائلة</label>
        @if (allowPartial)
        {
            <input class="form-control" asp-for="FamilyName" />
        }
        else
        {
            <input class="form-control" asp-for="FamilyName" required />
        }
    </div>

    <div class="col-md-6">
        <label class="form-label">تاريخ الميلاد</label>
        <input class="form-control" asp-for="BirthDate" type="date" />
    </div>
    <div class="col-md-6">
        <label class="form-label">مكان الميلاد</label>
        <input class="form-control" asp-for="BirthPlace" />
    </div>

    <div class="col-md-4">
        <label class="form-label">المهنة</label>
        <input class="form-control" asp-for="Profession" />
    </div>
    <div class="col-md-4">
        <label class="form-label">النوع</label>
        <select class="form-select" asp-for="Gender">
            <option>ذكر</option>
            <option>أنثى</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">اسم الأم</label>
        <input class="form-control" asp-for="MotherName" />
    </div>

    <div class="col-md-4">
        <label class="form-label">مكان الإقامة</label>
        <input class="form-control" asp-for="Residence" />
    </div>
    <div class="col-md-4">
        <label class="form-label">الحي / الحلة</label>
        <input class="form-control" asp-for="Neighborhood" />
    </div>
    <div class="col-md-4">
        <label class="form-label">الهاتف</label>
        <input class="form-control" asp-for="Phone" />
    </div>

    <div class="col-12">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" asp-for="IsMigrant" id="isMigrant" />
            <label class="form-check-label" for="isMigrant">مغترب (مقيم خارج البلد)</label>
        </div>
    </div>
    <div class="col-md-6" id="migrationCountryWrap">
        <label class="form-label">دولة المهجر</label>
        <input class="form-control" asp-for="MigrationCountry" placeholder="مثال: السعودية، الإمارات..." />
        <span asp-validation-for="MigrationCountry" class="text-danger small"></span>
    </div>
    <div class="col-md-6" id="migrationCityWrap">
        <label class="form-label">مدينة المهجر</label>
        <input class="form-control" asp-for="MigrationCity" placeholder="مثال: الرياض، دبي..." />
        <span asp-validation-for="MigrationCity" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label">نوع الوثيقة</label>
        <select class="form-select" asp-for="DocumentType">
            @foreach (var t in DocumentTypes.All)
            {
                if (Model.DocumentType == t)
                {
                    <option value="@t" selected>@t</option>
                }
                else
                {
                    <option value="@t">@t</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">رقم الوثيقة</label>
        <input class="form-control" asp-for="DocumentNumber" placeholder="رقم الوثيقة" />
    </div>
    <div class="col-md-4">
        <label class="form-label">صورة الوثيقة (اختياري)</label>
        <input type="hidden" asp-for="DocumentImagePath" />
        <input class="form-control" type="file" name="Document" accept=".jpg,.jpeg,.png,.webp,.gif,.pdf" />
        @if (!string.IsNullOrWhiteSpace(Model?.DocumentImagePath))
        {
            <div class="form-text">الحالية: @Model.DocumentImagePath</div>
        }
    </div>

    <div class="col-md-6">
        <label class="form-label">الصورة الشخصية (اختياري)</label>
        <input type="hidden" asp-for="PhotoPath" />
        <input class="form-control" type="file" name="Photo" accept=".jpg,.jpeg,.png,.webp,.gif" />
        <div class="form-text">يمكنك تخطي رفع الصورة والحفظ بدونها.</div>
        @if (!string.IsNullOrWhiteSpace(Model?.PhotoPath))
        {
            <div class="mt-2">
                <img class="person-photo-thumb" src="~/uploads/@Model.PhotoPath" alt="الصورة الحالية" />
            </div>
        }
    </div>
    <div class="col-md-6">
        <label class="form-label">ملاحظات / بيانات خاصة</label>
        <textarea class="form-control" asp-for="Notes" rows="3"></textarea>
    </div>
</div>

<script>
    (function () {
        var cb = document.getElementById('isMigrant');
        var countryWrap = document.getElementById('migrationCountryWrap');
        var cityWrap = document.getElementById('migrationCityWrap');
        if (!cb || !countryWrap || !cityWrap) return;

        function sync() {
            var show = cb.checked;
            countryWrap.style.display = show ? '' : 'none';
            cityWrap.style.display = show ? '' : 'none';
        }

        cb.addEventListener('change', sync);
        sync();
    })();
</script>
