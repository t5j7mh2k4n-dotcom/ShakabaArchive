@page "{id:int}"
@model ShakabaArchive.Web.Pages.People.DetailsModel
@{
    ViewData["Title"] = Model.Person?.FullName ?? "تفاصيل سجل أشخاص";
    var p = Model.Person!;
}

@if (Model.Person is null)
{
    <div class="alert alert-warning">السجل غير موجود.</div>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div class="d-flex flex-wrap align-items-start gap-3">
            <div class="person-photo-frame">
                @if (!string.IsNullOrWhiteSpace(p.PhotoPath))
                {
                    <img class="person-photo" src="~/uploads/@p.PhotoPath" alt="الصورة الشخصية لـ @p.FullName" />
                }
                else
                {
                    <div class="person-photo-placeholder">لا توجد صورة</div>
                }
            </div>
            <div>
                <h1 class="h3 mb-1">@p.FullName</h1>
                <div class="muted">
                    كود <code>@p.RegistryCode</code> —
                    @PersonRegistryService.LevelLabel(p.HierarchyLevel)
                    @if (!string.IsNullOrWhiteSpace(p.BirthPlace))
                    {
                        <text> — @p.BirthPlace</text>
                    }
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-soft" asp-page="Index">رجوع لسجل الأشخاص</a>
            @{
                var detailsUrl = $"{WhatsAppShare.PublicSiteUrl}/People/Details/{p.Id}";
            }
            <a class="btn btn-whatsapp"
               href="@WhatsAppShare.PersonShareUrl(p.FullName, detailsUrl)"
               target="_blank" rel="noopener">واتساب</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="btn btn-accent" asp-page="Edit" asp-route-id="@p.Id">تعديل</a>
                <a class="btn btn-soft" asp-page="/Occasions/Create" asp-route-personId="@p.Id">مناسبة جديدة</a>
            }
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card-panel">
                <dl class="row mb-0">
                    <dt class="col-sm-3">الكود</dt><dd class="col-sm-9"><code>@p.RegistryCode</code></dd>
                    <dt class="col-sm-3">المستوى</dt><dd class="col-sm-9">@PersonRegistryService.LevelLabel(p.HierarchyLevel)</dd>
                    <dt class="col-sm-3">الاسم الأول</dt><dd class="col-sm-9">@p.FirstName</dd>
                    <dt class="col-sm-3">اسم الأب</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.FatherName) ? "—" : p.FatherName)</dd>
                    <dt class="col-sm-3">اسم الجد</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.GrandfatherName) ? "—" : p.GrandfatherName)</dd>
                    <dt class="col-sm-3">اسم العائلة</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.FamilyName) ? "—" : p.FamilyName)</dd>
                    <dt class="col-sm-3">اسم الأم</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.MotherName) ? "—" : p.MotherName)</dd>
                    <dt class="col-sm-3">النوع</dt><dd class="col-sm-9">@p.Gender</dd>
                    <dt class="col-sm-3">تاريخ الميلاد</dt><dd class="col-sm-9">@(p.BirthDate?.ToString("yyyy-MM-dd") ?? "—")</dd>
                    <dt class="col-sm-3">مكان الميلاد</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.BirthPlace) ? "—" : p.BirthPlace)</dd>
                    <dt class="col-sm-3">المهنة</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.Profession) ? "—" : p.Profession)</dd>
                    <dt class="col-sm-3">الإقامة</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.Residence) ? "—" : p.Residence)</dd>
                    <dt class="col-sm-3">الحي</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.Neighborhood) ? "—" : p.Neighborhood)</dd>
                    <dt class="col-sm-3">الهاتف</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.Phone) ? "—" : p.Phone)</dd>
                    <dt class="col-sm-3">نوع الوثيقة</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.DocumentType) ? DocumentTypes.NationalId : p.DocumentType)</dd>
                    <dt class="col-sm-3">رقم الوثيقة</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.DocumentNumber) ? (string.IsNullOrWhiteSpace(p.NationalId) ? "—" : p.NationalId) : p.DocumentNumber)</dd>
                    <dt class="col-sm-3">ملاحظات</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.Notes) ? "—" : p.Notes)</dd>
                </dl>
            </div>

            @if (Model.Children.Count > 0)
            {
                <div class="card-panel mt-3">
                    <h2 class="h5 mb-3">الأبناء في الشجرة (@Model.Children.Count)</h2>
                    <ul class="mb-0">
                        @foreach (var c in Model.Children)
                        {
                            <li>
                                <code>@c.RegistryCode</code>
                                — <a asp-page="Details" asp-route-id="@c.Id">@c.FullName</a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="card-panel mt-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h2 class="h5 mb-0">المناسبات الاجتماعية</h2>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-sm btn-accent" asp-page="/Occasions/Create" asp-route-personId="@p.Id">إضافة مناسبة</a>
                }
            </div>
                @if (p.Events.Count == 0)
                {
                    <p class="muted mb-0">لا توجد مناسبات مسجّلة.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                            <tr>
                                <th>النوع</th>
                                <th>التصنيف</th>
                                <th>التاريخ</th>
                                <th>المكان</th>
                                <th>التفاصيل</th>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <th></th>
                                }
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var e in p.Events.OrderByDescending(x => x.EventDate))
                            {
                                <tr>
                                    <td>@EventTypeLabels.ToArabic(e.Type)</td>
                                    <td>@EventTypeLabels.MoodArabic(e.Mood)</td>
                                    <td>@(e.EventDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    <td>@e.Place</td>
                                    <td>
                                        <div>@e.Title</div>
                                        @if (!string.IsNullOrWhiteSpace(e.RelatedPersonName))
                                        {
                                            <div class="small muted">ذو صلة: @e.RelatedPersonName @e.RelatedFatherName</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(e.ChildFullName))
                                        {
                                            <div class="small muted">المولود: @e.ChildFullName (@e.ChildGender)</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(e.Institution))
                                        {
                                            <div class="small muted">@e.Institution — @e.Specialty — @e.Degree</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(e.Details))
                                        {
                                            <div class="small">@e.Details</div>
                                        }
                                    </td>
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <td>
                                            <a asp-page="/People/Events/Edit" asp-route-id="@e.Id">تعديل</a>
                                        </td>
                                    }
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card-panel mb-3 person-barcode-card">
                <partial name="_PersonCodesCard" model="PersonCodesCardView.ForPerson(p, Model.PersonDetailsUrl)" />
            </div>
            <div class="card-panel mb-3">
                <h2 class="h6 mb-3">الصورة الشخصية</h2>
                @if (!string.IsNullOrWhiteSpace(p.PhotoPath))
                {
                    <img class="person-photo person-photo-side" src="~/uploads/@p.PhotoPath" alt="الصورة الشخصية" />
                }
                else
                {
                    <p class="muted mb-0">لم تُرفع صورة شخصية بعد.</p>
                }
            </div>
            <div class="card-panel">
                <h2 class="h6 mb-3">صورة الوثيقة</h2>
                @if (!string.IsNullOrWhiteSpace(p.DocumentImagePath))
                {
                    var ext = System.IO.Path.GetExtension(p.DocumentImagePath).ToLowerInvariant();
                    if (ext == ".pdf")
                    {
                        <a href="~/uploads/@p.DocumentImagePath" target="_blank">فتح ملف PDF</a>
                    }
                    else
                    {
                        <img class="doc-preview w-100" src="~/uploads/@p.DocumentImagePath" alt="وثيقة" />
                    }
                }
                else
                {
                    <p class="muted mb-0">لا توجد وثيقة مرفقة.</p>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="~/js/person-barcode.js" asp-append-version="true"></script>
}
