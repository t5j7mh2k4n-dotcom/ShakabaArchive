@page "{id:int}"
@model ShakabaArchive.Web.Pages.People.Events.EditModel
@{
    ViewData["Title"] = "تعديل مناسبة";
}

<div class="card-panel">
    <h1 class="h4 mb-3">تعديل مناسبة</h1>
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PersonId" />
        <partial name="_EventForm" for="Input" />
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-accent" type="submit">إرسال التعديل للموافقة</button>
            <a class="btn btn-soft" asp-page="/People/Details" asp-route-id="@Model.PersonId">إلغاء</a>
            <button class="btn btn-outline-danger ms-auto" type="submit" asp-page-handler="Delete"
                    onclick="return confirm('إرسال طلب حذف هذه المناسبة؟ لن تُحذف إلا بعد موافقة أحد المخولين.');">طلب حذف</button>
        </div>
    </form>
</div>
