@page
@model ShakabaArchive.Web.Pages.Account.UsersModel
@{
    ViewData["Title"] = "المستخدمون والصلاحيات";
    var isEditing = Model.EditingUser is not null;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">المستخدمون والصلاحيات</h1>
        <p class="muted mb-0">
            الأدمن الرئيسي يضيف ويعدّل ويحذف المستخدمين، ويعيّن الثلاثة الموافقين، ويضع كلمة المرور الأولية أو يعيد تعيينها فقط من هنا — ولا تظهر كلمات المرور المحفوظة لأحد.
        </p>
    </div>
    @if (User.IsInRole("Admin") && !isEditing)
    {
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-soft" asp-page="./UsersReport">تقرير المستخدمين</a>
            <a class="btn btn-accent" href="#add-user">إضافة مستخدم</a>
        </div>
    }
</div>

@if (!User.IsInRole("Admin"))
{
    <div class="alert alert-warning">هذه الصفحة للأدمن الرئيسي فقط.</div>
}
else
{
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success">@Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }

    <div class="alert alert-info">
        إجمالي المستخدمين: <strong>@Model.Users.Count</strong> / @Model.MaxUsers
        — الموافقون: <strong>@Model.ApproverCount</strong> / @Model.MaxApprovers
        — الأدمن الرئيسي منفصل عنهم.
        <br />
        تخزين الحسابات: <strong>@Model.StorageLabel</strong>
        <br />
        <strong>رمز أمان الأسرة</strong> يظهر في الجدول أدناه أمام كل مستخدم (عمود «رمز الأمان»). يُنشأ تلقائياً إن لم يكن موجوداً.
    </div>

    @if (!Model.CanPersistUsers)
    {
        <div class="alert alert-danger">
            <strong>تحذير مهم:</strong> @LocalUserService.PersistBlockedMessage
            <br />
            من Render → Environment أضف:
            <code>DATABASE_URL</code> = رابط Neon (postgresql://...) ثم Save و Manual Deploy.
            بعدها أعد إضافة المستخدمين مرة واحدة ولن يُمسحوا.
        </div>
    }

    <div class="card-panel mb-3" id="add-user">
        <h2 class="h6 mb-3">@(isEditing ? $"تعديل مستخدم: {Model.EditingUser!.DisplayName}" : "إضافة مستخدم جديد")</h2>
        @if (!Model.CanPersistUsers && !isEditing)
        {
            <p class="text-danger mb-0">أضف <code>DATABASE_URL</code> في Render قبل إضافة مستخدمين جدد.</p>
        }
        else
        {
        <form method="post"
              asp-page-handler="@(isEditing ? "Update" : "Create")"
              class="row g-2 align-items-end">
            @if (isEditing)
            {
                <input type="hidden" name="userId" value="@Model.EditingUser!.Id" />
            }
            <div class="col-md-3">
                <label class="form-label">الاسم</label>
                <input class="form-control" asp-for="Form.DisplayName" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">البريد</label>
                <input class="form-control" asp-for="Form.Email" type="email" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">الهاتف</label>
                <input class="form-control" asp-for="Form.Phone" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">@(isEditing ? "إعادة تعيين كلمة المرور (اختياري)" : "كلمة المرور الأولية")</label>
                @if (isEditing)
                {
                    <input class="form-control" asp-for="Form.Password" type="password" autocomplete="new-password" placeholder="اتركه فارغاً للإبقاء" />
                }
                else
                {
                    <input class="form-control" asp-for="Form.Password" type="password" autocomplete="new-password" required />
                }
                <div class="form-text">لا تُعرض كلمة المرور لأحد بعد الحفظ. للمستخدم تغييرها من حسابه.</div>
            </div>
            <div class="col-md-2">
                <label class="form-label">الصلاحية</label>
                <select class="form-select" asp-for="Form.Role">
                    <option value="@((int)UserRole.Editor)">مدخل بيانات</option>
                    <option value="@((int)UserRole.Approver)">موافق على صحة البيانات</option>
                    <option value="@((int)UserRole.Admin)">أدمن رئيسي</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">رمز أمان الأسرة</label>
                <input class="form-control" asp-for="Form.SecurityCode" autocomplete="off"
                       placeholder="@(isEditing ? "اتركه فارغاً للإبقاء" : "اختياري — يُولَّد تلقائياً")" />
                <div class="form-text">ثابت للأسرة — يظهر مع اسم صاحب الأسرة.</div>
            </div>
            <div class="col-12 d-flex flex-wrap gap-2 mt-2">
                <button class="btn btn-accent" type="submit">
                    @(isEditing ? "حفظ التعديل" : "إضافة المستخدم")
                </button>
                @if (isEditing)
                {
                    <a class="btn btn-soft" asp-page="./Users">إلغاء</a>
                }
            </div>
        </form>
        }
    </div>

    <div class="card-panel">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                <tr>
                    <th>صاحب الأسرة</th>
                    <th>البريد</th>
                    <th>الهاتف</th>
                    <th>اسم الأسرة</th>
                    <th>رمز الأمان</th>
                    <th>الدور</th>
                    <th>الصلاحيات</th>
                    <th style="width:160px">إجراءات</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var u in Model.Users)
                {
                    var isAdmin = u.IsAdmin || u.Role == UserRole.Admin;
                    var isApprover = !isAdmin && u.Role == UserRole.Approver;
                    <tr class="@(isAdmin ? "table-admin-row" : "")">
                        <td>
                            @u.DisplayName
                            @if (isAdmin)
                            {
                                <span class="badge badge-soft ms-1">أدمن رئيسي</span>
                            }
                        </td>
                        <td>@u.Email</td>
                        <td>@u.Phone</td>
                        <td>@(string.IsNullOrWhiteSpace(u.FamilyName) ? "—" : u.FamilyName)</td>
                        <td style="min-width:12rem">
                            @if (!string.IsNullOrWhiteSpace(u.SecurityCode))
                            {
                                <div class="mb-1">
                                    <code class="fs-6 user-select-all">@u.SecurityCode</code>
                                </div>
                            }
                            else
                            {
                                <div class="text-danger small mb-1">لا يوجد رمز — سيُولَّد عند الحفظ</div>
                            }
                            <form method="post" asp-page-handler="SetSecurityCode" class="d-flex flex-wrap gap-1 align-items-center">
                                <input type="hidden" name="userId" value="@u.Id" />
                                <input class="form-control form-control-sm" style="min-width:7rem;max-width:9rem"
                                       name="securityCode" value="@u.SecurityCode" required autocomplete="off"
                                       placeholder="رمز الأمان" />
                                <button class="btn btn-sm btn-accent" type="submit">حفظ الرمز</button>
                            </form>
                        </td>
                        <td>@RoleClaims.ToArabic(isAdmin ? UserRole.Admin : u.Role)</td>
                        <td>
                            <form method="post" asp-page-handler="SetPermissions" class="perm-checks">
                                <input type="hidden" name="userId" value="@u.Id" />
                                <label class="perm-check">
                                    <input type="checkbox" checked disabled />
                                    <span>إدخال بيانات</span>
                                </label>
                                <label class="perm-check">
                                    <input type="checkbox"
                                           name="canApprove"
                                           value="true"
                                           @(isApprover || isAdmin ? "checked" : null)
                                           onchange="this.form.submit()" />
                                    <span>موافقة على صحة البيانات</span>
                                </label>
                                <label class="perm-check">
                                    <input type="checkbox"
                                           name="isMainAdmin"
                                           value="true"
                                           @(isAdmin ? "checked" : null)
                                           onchange="this.form.submit()" />
                                    <span>أدمن رئيسي</span>
                                </label>
                            </form>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <a class="btn btn-sm btn-soft" asp-page="./Users" asp-route-editId="@u.Id">تعديل</a>
                                <form method="post" asp-page-handler="Delete" class="d-inline"
                                      onsubmit="return confirm('حذف المستخدم @u.DisplayName؟');">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button class="btn btn-sm btn-danger-soft" type="submit">حذف</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.Users.Count == 0)
        {
            <p class="muted mt-3 mb-0">لا يوجد مستخدمون بعد. أضف مستخدماً من النموذج أعلاه.</p>
        }
    </div>
}
