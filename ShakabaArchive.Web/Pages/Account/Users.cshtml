@page
@model ShakabaArchive.Web.Pages.Account.UsersModel
@{
    ViewData["Title"] = "المستخدمون والصلاحيات";
}

<div class="mb-3">
    <h1 class="h4 mb-1">المستخدمون والصلاحيات</h1>
    <p class="muted mb-0">
        الأدمن الرئيسي يظهر أولاً ويضيف المستخدمين والثلاثة الموافقين.
        بيانات مدخلي البيانات لا تُحفظ في الأرشيف إلا بعد موافقة أحد الثلاثة.
    </p>
</div>

@if (!User.IsInRole("Admin"))
{
    <div class="alert alert-warning">هذه الصفحة للأدمن الرئيسي فقط.</div>
}
else
{
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success">@Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }

    <div class="alert alert-info">
        الموافقون على صحة البيانات: <strong>@Model.ApproverCount</strong> / @Model.MaxApprovers
        — الأدمن الرئيسي منفصل عنهم.
    </div>

    <div class="card-panel">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                <tr>
                    <th>الاسم</th>
                    <th>البريد</th>
                    <th>الهاتف</th>
                    <th>الدور</th>
                    <th>الصلاحيات</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var u in Model.Users)
                {
                    var isAdmin = u.IsAdmin || u.Role == UserRole.Admin;
                    var isApprover = !isAdmin && u.Role == UserRole.Approver;
                    <tr class="@(isAdmin ? "table-admin-row" : "")">
                        <td>
                            @u.DisplayName
                            @if (isAdmin)
                            {
                                <span class="badge badge-soft ms-1">أدمن رئيسي</span>
                            }
                        </td>
                        <td>@u.Email</td>
                        <td>@u.Phone</td>
                        <td>@RoleClaims.ToArabic(isAdmin ? UserRole.Admin : u.Role)</td>
                        <td>
                            <form method="post" asp-page-handler="SetPermissions" class="perm-checks">
                                <input type="hidden" name="userId" value="@u.Id" />
                                <label class="perm-check">
                                    <input type="checkbox" checked disabled />
                                    <span>إدخال بيانات</span>
                                </label>
                                <label class="perm-check">
                                    <input type="checkbox"
                                           name="canApprove"
                                           value="true"
                                           @(isApprover || isAdmin ? "checked" : null)
                                           onchange="this.form.submit()" />
                                    <span>موافقة على صحة البيانات</span>
                                </label>
                                <label class="perm-check">
                                    <input type="checkbox"
                                           name="isMainAdmin"
                                           value="true"
                                           @(isAdmin ? "checked" : null)
                                           onchange="this.form.submit()" />
                                    <span>أدمن رئيسي</span>
                                </label>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
