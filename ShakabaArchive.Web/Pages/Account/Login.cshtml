@page
@model ShakabaArchive.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "دخول";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card-panel">
            <h1 class="h4 mb-3">دخول المستخدم</h1>
            <p class="muted small">الدخول بالبريد الإلكتروني أو رقم الهاتف. بعد إنشاء الحساب يجب تأكيد البريد من الرابط في الإيميل.</p>
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success">@Model.SuccessMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <form method="post">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <div class="mb-3">
                    <label class="form-label">البريد أو الهاتف</label>
                    <input class="form-control" asp-for="Login" />
                </div>
                <div class="mb-3">
                    <label class="form-label">كلمة المرور</label>
                    <input class="form-control" asp-for="Password" type="password" />
                </div>
                <button class="btn btn-accent w-100" type="submit">دخول</button>
            </form>
            <p class="mt-2 mb-0 text-center">
                <a asp-page="/Account/ForgotPassword">نسيت كلمة المرور؟</a>
            </p>
            @if (Model.NeedsEmailVerification)
            {
                <form method="post" asp-page-handler="ResendVerification" class="mt-2">
                    <input type="hidden" asp-for="Login" />
                    <input type="hidden" asp-for="Password" />
                    <button class="btn btn-soft w-100" type="submit">إعادة إرسال رابط التأكيد</button>
                </form>
            }
            <p class="mt-3 mb-0">
                ليس لديك حساب؟
                <a asp-page="/Account/Register">سجّل مجاناً وأضف بياناتك</a>
            </p>
        </div>
    </div>
</div>
