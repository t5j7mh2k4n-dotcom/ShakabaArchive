@page
@model ShakabaArchive.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "دخول";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card-panel">
            <h1 class="h4 mb-3">دخول المستخدم</h1>
            <p class="muted small">المستخدمون محفوظون على هذا الجهاز — الدخول بالبريد أو رقم الهاتف.</p>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">البريد أو الهاتف</label>
                    <input class="form-control" asp-for="Login" />
                </div>
                <div class="mb-3">
                    <label class="form-label">كلمة المرور</label>
                    <input class="form-control" asp-for="Password" type="password" />
                </div>
                <button class="btn btn-accent w-100" type="submit">دخول</button>
            </form>
            <p class="mt-3 mb-0">
                مستخدم جديد؟
                <a asp-page="/Account/Register">التسجيل برقم الدعوة</a>
            </p>
            <p class="muted small mt-2 mb-0">الأمين: abohosam@shukaba.local</p>
        </div>
    </div>
</div>
