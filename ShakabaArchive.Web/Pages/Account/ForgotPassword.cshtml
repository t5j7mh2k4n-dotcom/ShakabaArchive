@page
@model ShakabaArchive.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "نسيت كلمة المرور";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card-panel">
            <h1 class="h4 mb-3">استعادة كلمة المرور</h1>
            <p class="muted small">
                أدخل <strong>نفس البريد ورقم الهاتف</strong> اللذين سجّلت بهما حسابك.
                إذا تطابقت البيانات، ستنتقل لصفحة تعيين كلمة مرور جديدة.
            </p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">البريد الإلكتروني</label>
                    <input class="form-control" asp-for="Email" type="email" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">رقم الهاتف</label>
                    <input class="form-control" asp-for="Phone" autocomplete="tel" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <button class="btn btn-accent w-100" type="submit">متابعة الاستعادة</button>
            </form>

            <p class="mt-3 mb-0">
                <a asp-page="./Login">رجوع لتسجيل الدخول</a>
            </p>
            <p class="muted small mt-2 mb-0">
                إذا لم تتذكر بياناتك، تواصل مع الأدمن الرئيسي لتعيين كلمة مرور جديدة من صفحة المستخدمون.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
