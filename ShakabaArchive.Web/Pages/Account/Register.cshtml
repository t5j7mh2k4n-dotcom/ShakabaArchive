@page
@model ShakabaArchive.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "تسجيل مستخدم جديد";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card-panel">
            <h1 class="h4 mb-3">إنشاء حساب جديد</h1>
            <p class="muted">
                سجّل باسمك وبريدك وكلمة مرور خاصة بك، ثم أضف بياناتك في سجل الأشخاص.
                الحفظ النهائي يتم بعد موافقة الأدمن أو أحد الموافقين.
            </p>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <form method="post" autocomplete="off">
                <div class="mb-3">
                    <label class="form-label">الاسم</label>
                    <input class="form-control" asp-for="DisplayName" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">البريد الإلكتروني</label>
                    <input class="form-control" asp-for="Email" type="email" required autocomplete="username" />
                </div>
                <div class="mb-3">
                    <label class="form-label">رقم الهاتف</label>
                    <input class="form-control" asp-for="Phone" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">كلمة المرور</label>
                    <input class="form-control" asp-for="Password" type="password" required minlength="6" autocomplete="new-password" />
                    <div class="form-text">6 أحرف على الأقل — خاصة بك ولا تظهر للآخرين.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">تأكيد كلمة المرور</label>
                    <input class="form-control" asp-for="ConfirmPassword" type="password" required minlength="6" autocomplete="new-password" />
                </div>
                <button class="btn btn-accent w-100" type="submit">إنشاء الحساب والدخول</button>
            </form>
            <p class="mt-3 mb-0"><a asp-page="/Account/Login">لديك حساب؟ تسجيل الدخول</a></p>
        </div>
    </div>
</div>
