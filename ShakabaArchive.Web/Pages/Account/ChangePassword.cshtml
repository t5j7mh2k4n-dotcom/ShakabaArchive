@page
@model ShakabaArchive.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card-panel">
            <h1 class="h4 mb-1">تغيير كلمة المرور</h1>
            <p class="muted mb-3">كلمة المرور خاصة بحسابك فقط ولا تظهر لأي مستخدم آخر. تُحفظ مشفّرة ولا يمكن قراءتها لاحقاً.</p>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-success">@Model.Message</div>
            }
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="alert alert-danger">@Model.Error</div>
            }

            <form method="post" class="row g-3" autocomplete="off">
                <div class="col-12">
                    <label class="form-label">كلمة المرور الحالية</label>
                    <input class="form-control" asp-for="Input.CurrentPassword" autocomplete="current-password" />
                    <span asp-validation-for="Input.CurrentPassword" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">كلمة المرور الجديدة</label>
                    <input class="form-control" asp-for="Input.NewPassword" autocomplete="new-password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">تأكيد كلمة المرور الجديدة</label>
                    <input class="form-control" asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-accent" type="submit">حفظ كلمة المرور</button>
                    <a class="btn btn-soft" asp-page="/Index">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
