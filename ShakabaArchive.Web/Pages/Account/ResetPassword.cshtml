@page
@model ShakabaArchive.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "كلمة مرور جديدة";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card-panel">
            <h1 class="h4 mb-3">تعيين كلمة مرور جديدة</h1>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success">@Model.SuccessMessage</div>
                <a class="btn btn-accent w-100" asp-page="./Login">تسجيل الدخول</a>
            }
            else
            {
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Token))
                {
                    <form method="post">
                        <input type="hidden" asp-for="Token" />
                        <div class="mb-3">
                            <label class="form-label">كلمة المرور الجديدة</label>
                            <input class="form-control" asp-for="NewPassword" type="password" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">تأكيد كلمة المرور</label>
                            <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <button class="btn btn-accent w-100" type="submit">حفظ كلمة المرور</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-soft w-100" asp-page="./ForgotPassword">طلب رابط استعادة جديد</a>
                }

                <p class="mt-3 mb-0">
                    <a asp-page="./Login">رجوع لتسجيل الدخول</a>
                </p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
