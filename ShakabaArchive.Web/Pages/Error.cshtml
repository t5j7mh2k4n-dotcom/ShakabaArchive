@page
@model ErrorModel
@{
    ViewData["Title"] = "خطأ";
}

<div class="card-panel">
    <h1 class="h4 text-danger mb-2">حدث خطأ أثناء معالجة الطلب</h1>
    <p class="mb-3">
        غالباً يكون السبب إيقاظ قاعدة البيانات بعد فترة توقف. انتظر نصف دقيقة ثم
        <a href="javascript:location.reload()">أعد تحميل الصفحة</a>
        أو ارجع إلى
        <a asp-page="/Index">الرئيسية</a>.
    </p>
    @if (Model.ShowRequestId)
    {
        <p class="muted small mb-0">رقم الطلب: <code>@Model.RequestId</code></p>
    }
</div>
