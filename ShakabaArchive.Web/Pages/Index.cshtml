@page
@model IndexModel
@{
    ViewData["Title"] = "أرشيف الشكابة شاع الدين";
    ViewData["AppShell"] = true;
    var authed = User.Identity?.IsAuthenticated == true;
    var dbUser = authed ? User.CurrentAppUser() : null;
    var isAdmin = User.IsInRole("Admin") || dbUser?.IsAdmin == true || dbUser?.Role == UserRole.Admin;
}

<section class="app-launcher">
    <div class="app-launcher-hero">
        <img class="app-launcher-photo"
             src="~/images/shakaba-welcome-sign.png"
             asp-append-version="true"
             alt="مرحبا بكم في الشكابة شاع الدين — دار الكواحلة" />
    </div>
    <h1 class="app-launcher-title">أرشيف الشكابة شاع الدين</h1>
    <p class="app-launcher-sub">تطبيق السجل الأسري — انضم أو ادخل لإدارة بيانات أسرتك</p>

    @if (!authed)
    {
        <div class="app-launcher-actions">
            <a class="btn btn-accent btn-lg app-open-btn" asp-page="/Account/Register">
                الانضمام إلى سجل أرشيف الشكابة شاع الدين
            </a>
            <a class="btn btn-soft btn-lg" asp-page="/Account/Login">
                دخول — إذا كان لديك حساب
            </a>
        </div>
        <p class="muted small mt-3 mb-0">بعد الدخول يفتح موديول <strong>سجل الأسرة</strong> لتسجيل أفراد أسرتك ثم تصديرهم للسجل العام.</p>
    }
    else
    {
        <div class="app-launcher-actions">
            <a class="btn btn-accent btn-lg app-open-btn" asp-page="/Family/Index">
                فتح سجل الأسرة
            </a>
            @if (isAdmin)
            {
                <a class="btn btn-soft btn-lg" asp-page="/People/Index">
                    السجل العام (أدمن)
                </a>
            }
        </div>
        <p class="muted small mt-3 mb-0">مرحباً @User.Identity?.Name</p>
    }

    <div class="mt-4">
        <a class="btn btn-whatsapp" href="@WhatsAppShare.SiteShareUrl()" target="_blank" rel="noopener">
            مشاركة التطبيق عبر واتساب
        </a>
    </div>
</section>

<div class="dedication-marquee mt-4" aria-label="إهداء">
    @{
        const string dedication = "أرشيف الشكابة شاع الدين — إهداء إلى روح المرحوم — عبدالمحمود محمد علي — تصميم عمر عبدالمحمود";
    }
    <div class="dedication-track dedication-track-a" aria-hidden="true">
        <span>@dedication</span>
        <span>@dedication</span>
        <span>@dedication</span>
        <span>@dedication</span>
    </div>
    <div class="dedication-track dedication-track-b" aria-hidden="true">
        <span>@dedication</span>
        <span>@dedication</span>
        <span>@dedication</span>
        <span>@dedication</span>
    </div>
</div>
