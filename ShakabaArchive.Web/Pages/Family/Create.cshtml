@page
@model ShakabaArchive.Web.Pages.Family.CreateModel
@{
    ViewData["Title"] = "إضافة فرد للأسرة";
    ViewData["LockHierarchy"] = true;
    ViewData["AllowPartial"] = true;
    ViewBag.ParentOptions = Model.ParentOptions;
}

<div class="card-panel">
    <h1 class="h4 mb-2">إضافة فرد إلى @Model.Family.Name</h1>
    <p class="muted">يُحفظ مباشرة في سجل أسرتك والسجل العام <strong>بدون موافقة</strong>. يلزم رمز أمان الأسرة.</p>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <form method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label" asp-for="SecurityCode">رمز أمان الأسرة</label>
            <input class="form-control" asp-for="SecurityCode" required autocomplete="off"
                   placeholder="أدخل الرمز الثابت لأسرتك" />
            <span asp-validation-for="SecurityCode" class="text-danger"></span>
            <div class="form-text">الرمز يظهر في صفحة سجل الأسرة ولا يتغير.</div>
        </div>
        <partial name="~/Pages/People/_PersonForm.cshtml" for="Input" />
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-accent" type="submit">حفظ في سجل الأسرة</button>
            <a class="btn btn-soft" asp-page="Index">رجوع</a>
        </div>
    </form>
</div>
