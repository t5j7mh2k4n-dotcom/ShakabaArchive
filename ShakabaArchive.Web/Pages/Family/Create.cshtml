@page
@model ShakabaArchive.Web.Pages.Family.CreateModel
@{
    ViewData["Title"] = "إضافة فرد للأسرة";
    ViewData["LockHierarchy"] = true;
    ViewData["AllowPartial"] = true;
    ViewBag.ParentOptions = Model.ParentOptions;
}

<div class="card-panel">
    <h1 class="h4 mb-2">إضافة فرد إلى @Model.Family.Name</h1>
    <p class="muted">يُحفظ في سجل الأسرة الخاص بك. بعد الانتهاء صدّر الأفراد إلى السجل العام من صفحة سجل الأسرة.</p>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <form method="post" enctype="multipart/form-data">
        <partial name="~/Pages/People/_PersonForm.cshtml" for="Input" />
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-accent" type="submit">حفظ في سجل الأسرة</button>
            <a class="btn btn-soft" asp-page="Index">رجوع</a>
        </div>
    </form>
</div>
